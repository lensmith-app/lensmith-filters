{
  "formatVersion": 2,
  "minAppVersion": 3,
  "id": "lensmith-app.heart-rain",
  "name": "Heart Rain",
  "brightness": 0.03,
  "contrast": 1,
  "saturation": 1.1,
  "warmth": 0.15,
  "tint": 0.25,
  "fade": 0.12,
  "vignette": 0.2,
  "grain": 0,
  "colorize": [1, 1, 1],
  "colorizeAmount": 0,
  "effect": "None",
  "effectParam": 0,
  "stickers": [
    {
      "emoji": "💖",
      "anchor": "Forehead",
      "offsetX": 0.42,
      "offsetY": 0.3,
      "width": 0.22,
      "rotation": 15,
      "showWhen": "Always",
      "hidden": false
    }
  ],
  "warps": [],
  "background": "None",
  "backgroundTop": [1, 0.55, 0.3],
  "backgroundBottom": [0.45, 0.15, 0.55],
  "rules": [
    {
      "trigger": "Start",
      "cooldownMs": 250,
      "actions": [{ "type": "popup", "text": "Smile! 💕" }]
    },
    {
      "trigger": "Smile",
      "cooldownMs": 1500,
      "actions": [{ "type": "burst", "emoji": "💕", "count": 18, "style": "Rain", "size": 0.16 }]
    },
    {
      "trigger": "Blink",
      "cooldownMs": 400,
      "actions": [{ "type": "burst", "emoji": "❤️", "anchor": "BetweenEyes", "count": 12, "style": "Explode", "size": 0.14 }]
    }
  ],
  "doubleTapFlip": true
}
